OPENAI_API_KEY=sk-tu-clave
ANTHROPIC_API_KEY=sk-ant-tu-clave
# Obligatorio: docker compose no arranca Grafana sin esta contraseña
GRAFANA_PASSWORD=
HEALTHCHECKS_URL=
# Opcionales (sin secretos). Puerto publicado de la app en el host (por defecto 8000)
AGSGPT_PORT=8000
# health-check.sh: URL (por defecto http://127.0.0.1:${AGSGPT_PORT}/health),
# email de aviso y ruta del secreto SMTP (por defecto <repo>/monitoring/secrets/smtp_password)
# AGSGPT_HEALTH_URL=
AGSGPT_ALERT_EMAIL=tu-correo@example.com
# AGSGPT_SMTP_PASS_FILE=
# Estado compartido del circuit breaker entre workers
# AGSGPT_CIRCUIT_DB=/tmp/agsgpt_circuit.sqlite3
# Deduplicación del health-check: segundos entre avisos repetidos (por defecto 3600)
# AGSGPT_ALERT_REPEAT_SECONDS=3600
# AGSGPT_STATE_DIR=
