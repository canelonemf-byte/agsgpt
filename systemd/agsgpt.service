[Unit]
Description=agsgpt Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/workspace/agsgpt
ExecStartPre=/usr/bin/python3 scripts/render-alertmanager.py
ExecStart=/usr/bin/docker compose --env-file .env -f docker/docker-compose.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file .env -f docker/docker-compose.yml stop
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
